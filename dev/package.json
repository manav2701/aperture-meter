{
  "name": "aperture-meter-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Build and test tooling for the Aperture Meter plugin. The plugin itself ships as ../scripts/meter.mjs and needs none of this.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/manav2701/aperture-meter.git" },
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "tsx src/cli.ts",
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
